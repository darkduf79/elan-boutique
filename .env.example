# Configuration de l'adresse du serveur backend Élan pour l'application mobile
# Le préfixe EXPO_PUBLIC_ est requis par Expo pour rendre la variable accessible dans le code client.

# Choix de l'adresse selon votre environnement :
# - Navigateur Web / Simulateur iOS : http://localhost:3001/api
# - Émulateur Android (Android Studio) : http://10.0.2.2:3001/api
# - Appareil physique (Expo Go sur Wi-Fi) : http://<IP_LOCALE_DE_VOTRE_MACHINE>:3001/api (ex: http://192.168.1.50:3001/api)

EXPO_PUBLIC_API_URL=http://localhost:3001/api

# Stripe (mode test) : clé PUBLIABLE uniquement (pk_test_…). La clé secrète va dans server/.env
EXPO_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_51UXU2aEhHwl6MJBAWP1A7RSEaFCQM6EWGv8IF5jNy4jC5UiqDO2gzc8tn4zf0t1UgtT9d17Sgeb1k4XgvIPCAMfV00Q9UvnqnW
