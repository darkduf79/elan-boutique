    {
      "name": "12 · Upload d'image",
      "item": [
        {
          "name": "Téléverser une image (vendeur)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "image",
                  "type": "file",
                  "src": "",
                  "description": "Sélectionner un fichier JPG/PNG depuis Postman"
                }
              ]
            },
            "url": "{{baseUrl}}/uploads",
            "description": "Renvoie `{ url: \"/uploads/xxxx.jpg\" }`. L'URL complète est `https://VOTRE-API.onrender.com/uploads/xxxx.jpg` (sans `/api`).\n\n⚠️ Sur Render (plan gratuit), le disque est éphémère : les images téléversées disparaissent au redéploiement."
          }
        }
      ]
    }
