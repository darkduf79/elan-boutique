PORT=3001
HOST=0.0.0.0
NODE_ENV=development

# Secret de signature des tokens d'authentification (HMAC).
# Générez une valeur longue et aléatoire, par exemple : openssl rand -hex 32
AUTH_SECRET=change-me-with-a-long-random-secret

# Stripe (mode test) : clé SECRÈTE, uniquement ici, jamais dans l'application
# Récupérez la vôtre sur https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=sk_test_remplacez_par_votre_cle_secrete

# Devise Stripe (l'application affiche des "$" par défaut ; utiliser "eur" si besoin).
STRIPE_CURRENCY=usd
